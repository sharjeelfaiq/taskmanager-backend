{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "license": "ISC",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "format": "prettier --write \"./**/*.{js,jsx,html,yaml,env,md,json,txt}\"",
    "lint": "eslint \"./**/*.js\"",
    "format:check": "prettier --check \"./**/*.{js,jsx,html,yaml,env,md,json,txt}\"",
    "test": "node --test"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "envalid": "^8.1.1",
    "express": "^4.21.2",
    "http-errors": "^2.0.0",
    "joi": "^17.13.3",
    "mongoose": "^8.9.6",
    "morgan": "^1.10.0",
    "winston": "^3.17.0"
  },
  "imports": {
    "#api/*": "./src/api/*",
    "#config/*": "./src/config/*",
    "#lib/*": "./src/lib/*",
    "#middlewares/*": "./src/middlewares/*"
  }
}
